# Optional metadata only. No dotenv loader is used; export variables explicitly.
# Native runs must leave ABB_IMAGE_DIGEST unset.
# ABB_IMAGE_DIGEST=sha256:<actual-built-image-id-for-a-container-campaign>
# scripts/check_services.py accepts these endpoint overrides:
# ABB_HTTP_URL=http://http:8100
# ABB_A2A_URL=http://a2a:8100
